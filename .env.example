# which decision engine src/residents.py uses: gemini (Decisions API, default for this project)
# or jev (TypeSafe) — caches for both are committed under data/decisions/ and data/jev/
SIM_ENGINE=gemini
TYPESAFE_API_KEY=
GEMINI_API_KEY=
# live-call spend guard (src/budget.py); 0 disables that kind of live call
REPORT_LIVE_PER_DAY=20
REPORT_LIVE_PER_IP_HOUR=3
DECISIONS_LIVE_PER_DAY=2000
WHATIF_LIVE_PER_IP_HOUR=2
# comma-separated origins allowed by the API (default *)
EC_ORIGINS=
