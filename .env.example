# which decision engine src/residents.py uses: gemini (Decisions API, default for this project)
# or jev (TypeSafe) — caches for both are committed under data/decisions/ and data/jev/
SIM_ENGINE=gemini
TYPESAFE_API_KEY=
GEMINI_API_KEY=
# Claude for the analyst drawer (src/analyst.py, /api/ask) — model id overridable
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# comma-separated origins allowed by the API (default *)
EC_ORIGINS=
